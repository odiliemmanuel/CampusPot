# Copy to .env and fill in real values. .env is gitignored — never commit keys.
APP_ENV=development
PORT=8080
# Browser origins allowed to call the API, comma-separated. Localhost is always
# allowed; add your deployed frontend, e.g. https://campuspot.vercel.app
CORS_ORIGINS=

# Database driver: "postgres" (production) or "sqlite" (zero-setup local demo).
DB_DRIVER=postgres
# Optional: a single managed connection string (Neon/Render/Railway). When set
# it overrides the DB_HOST/DB_USER/... fields below. Neon gives you one URL
# (host + user + password + db) that ends with "sslmode=require".
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=campuspot
DB_PASSWORD=campuspot
DB_NAME=campuspot_dev
DB_SSLMODE=disable
# Used only when DB_DRIVER=sqlite
DB_PATH=campuspot.db
# GORM SQL logging: silent | error | warn | info (default warn; use info to debug)
GORM_LOG=warn

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# B Moni Embedded API — SANDBOX ONLY. Test data only, never real money/BVN.
# Leave BMONI_API_KEY empty to run against the in-process mock (great for demos).
BMONI_BASE_URL=https://sandbox.bmoni.com
BMONI_API_KEY=
BMONI_PARTNER_ID=
BMONI_WEBHOOK_SECRET=
BMONI_SANDBOX=true

# AI treasurer. Leave AI_API_KEY empty to use the deterministic rule-based
# fallback (works fully offline). Any OpenAI-compatible endpoint works.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
